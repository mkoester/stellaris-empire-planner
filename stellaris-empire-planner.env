# Committed, non-secret defaults shared across all deployments.
# The image already sets: NODE_ENV=production, PORT=3000, HOST=0.0.0.0,
# STELLARIS_DB=/app/data/stellaris.sqlite — repeated here only for visibility.

# Max request body size for adapter-node, in bytes (suffixes K/M/G allowed).
# Uncomment to override the 512K default.
# BODY_SIZE_LIMIT=512K
