[Unit]
Description=Stellaris Empire Planner (SvelteKit + adapter-node)
After=network-online.target
Wants=network-online.target

[Container]
# Local image loaded from a tarball (podman load) for now. Switch to a registry
# ref + AutoUpdate=registry once the app is pushed somewhere.
Image=localhost/stellaris-empire-planner:latest
AutoUpdate=local
# Never reach out to a registry — the image is supplied locally via `podman load`.
Pull=never

# The image runs as `node` (UID 1000). keep-id maps that UID to the service user, so the
# analytics DB written in the volume belongs to the service user on the host. Without it,
# rootless podman maps UID 1000 to a subuid and the directory is not writable from inside.
UserNS=keep-id:uid=1000,gid=1000
User=1000
Group=1000

# The game DB is baked into the image (/app/data/stellaris.sqlite, read-only; updating it
# means a rebuild). The one writable path is the analytics DB (docs/analytics.md): mount the
# directory, not the file, because SQLite writes its -wal/-shm files next to it.
Volume=%h/analytics:/app/analytics:Z

# Environment: committed defaults + per-deployment overrides.
EnvironmentFile=%h/.config/containers/systemd/stellaris-empire-planner.env
EnvironmentFile=%h/.config/containers/systemd/stellaris-empire-planner.override.env

# Bind to loopback only — fronted by the host's reverse proxy.
PublishPort=127.0.0.1:3000:3000

# Health check via Node (the slim image has no curl/wget); `/` returns 200.
HealthCmd=node -e "fetch('http://localhost:3000/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
# adapter-node boots in ~1-2s; generous ceiling, well under the guide's 900s.
TimeoutStartSec=60

[Install]
WantedBy=default.target
